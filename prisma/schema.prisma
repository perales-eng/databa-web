// datABA web — Prisma schema
// Multi-tenant from day 1: every domain entity belongs to an Organization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled endpoint de Neon en prod (rápido, sirve para runtime / server actions).
  url       = env("DATABASE_URL")
  // Direct endpoint para migraciones (`prisma migrate deploy` en build).
  // En dev local con Postgres en localhost no hay pooler, así que apunta al mismo URL.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH + MULTI-TENANT BASE
// ============================================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]

  // Audit trail
  createdStudents          Student[]            @relation("StudentCreatedBy")
  createdSessions          TherapySession[]     @relation("SessionCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  OWNER
  ADMIN
  THERAPIST
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  students         Student[]
  behaviors        Behavior[]
  behaviorMethods  BehaviorMethod[]
  therapySessions  TherapySession[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(THERAPIST)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(THERAPIST)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ============================================================
// ENUMS — domain
// ============================================================

enum MeasurementMethodType {
  FREQUENCY
  DURATION
  LATENCY
  INTENSITY
  TEMPORAL_SAMPLING
  PERCENTAGE_OPPORTUNITY
  EVENT_SAMPLING
  ANECDOTAL
  ABC
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionType {
  SCHEDULED
  IMMEDIATE
}

enum PeriodicType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum SamplingType {
  PARTIAL
  WHOLE
  MOMENTARY
}

enum OpportunityEndCondition {
  MANUAL
  TIME_LIMIT
  OPPORTUNITY_LIMIT
}

// ============================================================
// CORE DOMAIN
// ============================================================

model Student {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?  // hex
  birthDate      DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation("StudentCreatedBy", fields: [createdById], references: [id])
  behaviorMethods  BehaviorMethod[]
  therapySessions  TherapySession[]
  abcRecords       ABCRecord[]
  anecdotalRecords AnecdotalRecord[]
  eventSamplings   EventSampling[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

/// Conducta reutilizable (catálogo). Independiente del método de medición.
model Behavior {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  behaviorMethods BehaviorMethod[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// BehaviorMethod = plantilla de medición de una conducta para un estudiante con un método específico.
/// `config` es JSONB polimórfico — su shape depende de methodType (validado por Zod en la app).
model BehaviorMethod {
  id             String                @id @default(cuid())
  organizationId String
  studentId      String
  behaviorId     String?
  behaviorName   String                // snapshot for display even if behavior is deleted
  methodType     MeasurementMethodType
  description    String?
  functionTypes  Json?                 // array of strings (operant function categories)
  config         Json                  // method-specific configuration (validated by Zod)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  behavior          Behavior?           @relation(fields: [behaviorId], references: [id], onDelete: SetNull)
  results           MeasurementResult[]
  progress          MeasurementProgress[]
  opportunityResults     OpportunityResult[]
  temporalSamplingResults TemporalSamplingResult[]

  @@index([organizationId])
  @@index([studentId])
  @@index([methodType])
}

model TherapySession {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String
  createdById    String?
  title          String
  description    String?
  status         SessionStatus @default(PENDING)
  sessionType    SessionType   @default(SCHEDULED)
  sessionDate    DateTime
  durationMin    Int?
  isPeriodic     Boolean       @default(false)
  periodicType   PeriodicType  @default(NONE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SessionCreatedBy", fields: [createdById], references: [id])

  results                MeasurementResult[]
  progress               MeasurementProgress[]
  opportunityResults     OpportunityResult[]
  temporalSamplingResults TemporalSamplingResult[]
  abcRecords             ABCRecord[]
  anecdotalRecords       AnecdotalRecord[]
  eventSamplings         EventSampling[]

  @@index([organizationId])
  @@index([studentId])
  @@index([sessionDate])
  @@index([status])
}

/// Resultado genérico de una medición (frequency/duration/intensity/latency).
/// Para Opportunity y TemporalSampling existen tablas dedicadas con más detalle.
model MeasurementResult {
  id               String                @id @default(cuid())
  organizationId   String
  behaviorMethodId String
  sessionId        String
  methodType       MeasurementMethodType
  behaviorName     String
  resultValue      String                // numeric or stringified — interpreted per methodType
  resultUnit       String?               // "per_min", "seconds", "scale_1_10", "%", etc.
  measurementDate  DateTime              @default(now())
  sessionDurationSec Int?
  rawData          Json?                 // method-specific raw arrays (timestamps, durations, etc.)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  behaviorMethod BehaviorMethod  @relation(fields: [behaviorMethodId], references: [id], onDelete: Cascade)
  session        TherapySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([behaviorMethodId])
  @@index([sessionId])
  @@index([methodType])
}

model OpportunityResult {
  id                      String                  @id @default(cuid())
  organizationId          String
  behaviorMethodId        String
  sessionId               String
  studentId               String
  totalOpportunities      Int
  successfulOpportunities Int
  successPercentage       Float
  opportunityDetails      Json                    // array of { timestamp, status, note? }
  endCondition            OpportunityEndCondition @default(MANUAL)
  measurementDate         DateTime                @default(now())
  createdAt               DateTime                @default(now())

  behaviorMethod BehaviorMethod  @relation(fields: [behaviorMethodId], references: [id], onDelete: Cascade)
  session        TherapySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
}

model TemporalSamplingResult {
  id                       String       @id @default(cuid())
  organizationId           String
  behaviorMethodId         String
  sessionId                String
  studentId                String
  samplingType             SamplingType
  intervalDurationSec      Int
  totalDurationSec         Int
  totalIntervals           Int
  markedIntervals          Int
  markedPercentage         Float
  intervalDetails          Json         // array of { index, startSec, marked, note? }
  measurementDate          DateTime     @default(now())
  createdAt                DateTime     @default(now())

  behaviorMethod BehaviorMethod  @relation(fields: [behaviorMethodId], references: [id], onDelete: Cascade)
  session        TherapySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
}

model ABCRecord {
  id                       String   @id @default(cuid())
  organizationId           String
  studentId                String
  sessionId                String?
  behaviorName             String   @default("")
  occurredAt               DateTime
  durationSec              Int?
  location                 String?
  peoplePresent            String?
  antecedentType           String?
  antecedentDescription    String?
  behaviorDescription      String
  behaviorDurationSec      Int?
  behaviorIntensity        Int?
  behaviorTopography       String?
  consequenceType          String?
  consequenceDescription   String?
  whatObtained             String?
  whatAvoided              String?
  functionAnalysis         String?
  notes                    String?
  createdAt                DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session TherapySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentId])
  @@index([sessionId])
  @@index([occurredAt])
}

model AnecdotalRecord {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  sessionId      String?
  behaviorName   String   @default("")
  recordDate     DateTime
  recordTime     String?  // HH:mm — for ergonomy, separate from date
  title          String
  description    String
  context        String?
  category       String?
  observations   String?
  createdAt      DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session TherapySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentId])
  @@index([sessionId])
  @@index([recordDate])
}

model EventSampling {
  id                    String   @id @default(cuid())
  organizationId        String
  studentId             String
  sessionId             String?
  behaviorName          String
  sessionDurationMin    Int
  intensityScale        Int?
  dataSaveType          String?  // INDIVIDUAL | AVERAGE | BOTH
  data                  Json     // method-specific event records
  measurementDate       DateTime @default(now())
  createdAt             DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session TherapySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentId])
  @@index([sessionId])
}

/// Estado parcial de una medición en curso. Unifica las 10 *ProgressEntity de Android
/// en una sola tabla con methodType + data JSONB. Permite reanudar sesiones interrumpidas
/// y soportar el sistema paralelo (varias mediciones simultáneas).
model MeasurementProgress {
  id               String                @id @default(cuid())
  organizationId   String
  behaviorMethodId String
  sessionId        String
  methodType       MeasurementMethodType
  data             Json                  // method-specific snapshot
  startedAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?

  behaviorMethod BehaviorMethod  @relation(fields: [behaviorMethodId], references: [id], onDelete: Cascade)
  session        TherapySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([behaviorMethodId, sessionId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([completedAt])
}
