# ─── Database (Postgres) ──────────────────────────────────────────────────
# Local: usar docker-compose.yml de este repo (Postgres en 5433).
# Producción (Neon): DATABASE_URL = "Pooled connection" (con -pooler en el host
# y ?pgbouncer=true&connect_timeout=10). DIRECT_URL = "Direct connection".
# Neon recomienda pooled para serverless runtime y direct para `prisma migrate
# deploy` que corre en el build.
DATABASE_URL="postgresql://databa:databa_dev_password@localhost:5433/databa_dev?schema=public"
# En dev local apunta al mismo Postgres. En prod, el direct endpoint de Neon.
DIRECT_URL="postgresql://databa:databa_dev_password@localhost:5433/databa_dev?schema=public"

# ─── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
# URL pública canónica. En local apunta a localhost. En Vercel, setear al
# dominio de producción (https://tuapp.vercel.app o el dominio propio).
AUTH_URL="http://localhost:3000"

# ─── Feature flags ────────────────────────────────────────────────────────
# Habilita el registro público (página /signup). Default cerrado: si no está
# seteado o tiene cualquier otro valor, el signup queda deshabilitado. Para
# abrirlo, poner literalmente "true".
# SIGNUPS_ENABLED=true

# ─── Opcionales ───────────────────────────────────────────────────────────
# Email transaccional (Resend) — Fase 11
# AUTH_RESEND_KEY=
# EMAIL_FROM="datABA <noreply@databa.app>"

# OAuth providers (Fase 13)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Monitoreo errores (Fase 12) — opcional. Sin DSN, Sentry no carga.
# SENTRY_DSN=                       # server-side
# NEXT_PUBLIC_SENTRY_DSN=           # cliente (mismo DSN o uno separado)
